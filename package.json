{
  "name": "@samline/scroll-to",
  "version": "1.0.0",
  "description": "Smooth scrolling to elements, anchors and positions with offsets for fixed headers, alignment, durations, easing, focus and URL hash handling, for vanilla JavaScript, any framework and plain HTML.",
  "keywords": [
    "scroll-to",
    "smooth-scroll",
    "anchor",
    "scroll",
    "offset",
    "fixed-header",
    "scroll-into-view",
    "skip-link"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/scroll-to/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/scroll-to.git"
  },
  "bugs": {
    "url": "https://github.com/samline/scroll-to/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/browser/scroll-to.global.js"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/scroll-to.global.js",
  "jsdelivr": "./dist/browser/scroll-to.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./browser": "./dist/browser/scroll-to.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run size && bun run test:e2e",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage",
    "release": "bun run check && npm publish"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@samline/internal": "^1.0.0",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "size": {
    "./dist/index.js": 2500,
    "./dist/browser/scroll-to.global.js": 2600
  }
}
