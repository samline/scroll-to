---
import './_shared.css'
---

<div class="preview scroll-to-example">
  <div class="controls">
    <button type="button" class="pill" data-show>Show the answer to question 4</button>
    <output aria-live="polite"></output>
  </div>
  <div class="box" data-preview="await" tabindex="0" role="region" aria-label="Questions">
    {Array.from({ length: 6 }, (_, i) => (
      <article id={`scroll-to-q${i + 1}`}>
        <p class="part-title">Question {i + 1}</p>
        <p>Answer {i + 1}.</p>
      </article>
    ))}
  </div>
</div>

<script>
  import { cancelScroll, scrollTo } from '@samline/scroll-to'
  import { preview } from '../../shared/lib/preview'

  preview('await', stage => {
    const box = stage.querySelector<HTMLElement>('[data-preview="await"]')!
    const root = box.closest('.preview')!
    const status = root.querySelector('output')!
    let flash: ReturnType<typeof setTimeout> | undefined
    root.querySelector('[data-show]')!.addEventListener('click', async () => {
      const answer = box.querySelector<HTMLElement>('#scroll-to-q4')!
      status.value = 'Scrolling…'
      const arrived = await scrollTo(answer, { container: box, duration: 900 })
      if (!box.isConnected) return
      status.value = arrived ? 'Arrived' : 'Interrupted'
      if (!arrived) return
      answer.classList.add('flash')
      flash = setTimeout(() => answer.classList.remove('flash'), 1200)
    })
    return () => {
      cancelScroll(box)
      clearTimeout(flash)
    }
  })
</script>

<style>
  .controls {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  article {
    transition: background 0.6s;
  }
  article.flash {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
</style>
