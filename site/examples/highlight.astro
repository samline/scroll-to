---
import './_shared.css'

const terms = [
  ['cache', 'Cache', 'A copy kept close by, so the next read is fast.'],
  ['latency', 'Latency', 'How long one request waits for its answer.'],
  ['throughput', 'Throughput', 'How many requests finish each second.'],
]
---

<div class="preview scroll-to-example">
  <div class="terms">
    {terms.map(([id, term]) => (
      <a href={`#scroll-to-term-${id}`} class="pill" data-scroll-to-block="center">
        {term}
      </a>
    ))}
  </div>
  <div class="box" data-preview="highlight" tabindex="0" aria-label="Glossary">
    <dl>
      {terms.map(([id, term, definition]) => (
        <div class="entry">
          <dt id={`scroll-to-term-${id}`} class="part-title">{term}</dt>
          <dd><p>{definition}</p></dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<script>
  import { autoScrollTo } from '@samline/scroll-to'
  import { preview } from '../../shared/lib/preview'

  preview('highlight', stage => {
    const box = stage.querySelector<HTMLElement>('[data-preview="highlight"]')!
    // The links sit outside the box, so listen on the whole preview.
    return autoScrollTo({
      scope: box.closest('.preview')!,
      container: box,
      duration: 900,
      highlight: 1500,
      hash: false,
      initialHash: false,
    })
  })
</script>

<style>
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .terms a {
    text-decoration: none;
    background: linear-gradient(var(--color-accent-soft), var(--color-accent-soft))
      no-repeat left / calc(var(--scroll-to-progress, 0) * 100%) 100%;
  }
  dl {
    margin: 0;
    padding: 12rem 1rem;
  }
  .entry {
    margin-bottom: 14rem;
  }
  dt {
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-control);
  }
  dt[data-scroll-to-arrived] {
    background: var(--color-accent-soft);
  }
  dt:focus {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.125rem;
  }
  dd {
    margin: 0 0 0 0.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    dt {
      transition: background-color 0.6s;
    }
    dt[data-scroll-to-arrived] {
      animation: scroll-to-pulse 0.6s 2;
    }
  }
  @keyframes scroll-to-pulse {
    50% {
      scale: 1.04;
    }
  }
</style>
