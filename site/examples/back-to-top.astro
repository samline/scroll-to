---
import './_shared.css'
---

<div class="preview scroll-to-example">
  <div class="box" data-preview="back-to-top" tabindex="0" aria-label="Long article">
    {Array.from({ length: 6 }, (_, i) => (
      <section id={i === 0 ? 'scroll-to-article-start' : undefined}>
        <p class="part-title">Page {i + 1}</p>
        <p>Scroll down: the button appears after one screen, and its ring fills as you read.</p>
      </section>
    ))}
    <a class="back-to-top" href="#scroll-to-article-start" aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </a>
  </div>
</div>

<script>
  import { backToTop } from '@samline/scroll-to'
  import { preview } from '../../shared/lib/preview'

  preview('back-to-top', stage => {
    const box = stage.querySelector<HTMLElement>('[data-preview="back-to-top"]')!
    const button = box.querySelector('.back-to-top')
    // Focus moves to the first page once it arrives.
    const controller = backToTop(button, {
      container: box,
      target: '#scroll-to-article-start',
      threshold: '100%',
    })
    return () => {
      controller.destroy()
      box.scrollTop = 0
    }
  })
</script>

<style>
  .back-to-top {
    position: sticky;
    bottom: 0.75rem;
    margin: 0 0.75rem 0.75rem auto;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--color-text);
    background:
      radial-gradient(closest-side, var(--color-bg) 82%, transparent 84%),
      conic-gradient(
        var(--color-accent) calc(var(--scroll-to-scrolled, 0) * 1turn),
        var(--color-border) 0
      );
  }
  .back-to-top:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.125rem;
  }
  .back-to-top[data-scroll-to-visible='false'] {
    visibility: hidden;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .back-to-top {
      transition:
        opacity 0.3s,
        visibility 0.3s;
    }
  }
</style>
